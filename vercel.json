{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/delete-account",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|uploads|delete-account|assets|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
